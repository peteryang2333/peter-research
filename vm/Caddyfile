{
	# v2ray already owns 443, so the dashboard listens on 8443.
	# Port 80 is used only for the Let's Encrypt HTTP-01 challenge.
	http_port 80
	https_port 8443
	admin off
}

152-70-194-225.sslip.io:8443 {
	basic_auth {
		PLACEHOLDER_USER PLACEHOLDER_HASH
	}

	# "Re-collect now" trigger. peter-refreshd listens on a unix socket inside
	# this container's own volume - no host TCP port exists, so this
	# reverse_proxy is the single way in, and it sits behind basic_auth above.
	@api path /api/*
	handle @api {
		reverse_proxy unix//data/refreshd.sock
	}

	handle {
		root * /srv
		encode gzip
		file_server
	}

	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 2mb
			roll_keep 2
		}
		level ERROR
	}
}
