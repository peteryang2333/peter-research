# KovaView-OSS configuration (copy to .env, docker compose reads it)
# IBKR Client Portal Gateway URL (paper or live). Leave default for demo mode.
IBKR_BASE=http://host.docker.internal:5000
# Where the trade journal SQLite DB is stored (inside container: /data)
JOURNAL_DB=/data/journal.db
# Streamlit
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501
